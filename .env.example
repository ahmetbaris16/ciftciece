# Çiftçi Ece — ortam değişkenleri ÖRNEĞİ (gerçek değer yok, yazmayın).
# Yerelde: bu dosyayı .env olarak kopyalayıp doldurun. Canlıda (Hostinger): hPanel → Node.js → Ortam değişkenleri.
# Ayrıntı: docs/YAYIN.md (kurulum), docs/AKBANK_TEST.md (kartla ödeme), docs/TESTING.md (yerel test).

# --- Veritabanı (MariaDB / MySQL) ---
# Yerel Docker:          mysql://ciftciece:SIFRE@127.0.0.1:3316/ciftciece
# Hostinger (sunucudan): mysql://KULLANICI:SIFRE@localhost:3306/VERITABANI?connection_limit=5
DATABASE_URL=

# --- Site adresi ve oturum (ikisi aynı adres; canlıda https) ---
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# En az 32 karakter rastgele: openssl rand -base64 32
NEXTAUTH_SECRET=

# --- Kartla ödeme: Akbank Sanal POS (Ortak Ödeme Sayfası / 3D Pay Hosting) ---
# Bilgiler boşsa kart "yakında" görünür (demo). AKBANK_ENV=test: yalnız yönetici dener. prod: canlı tahsilat.
PAYMENT_PROVIDER=akbank
AKBANK_ENV=test
AKBANK_MERCHANT_SAFE_ID=
AKBANK_TERMINAL_SAFE_ID=
AKBANK_SECRET_KEY=
# Yalnız yerel denemede (sahte banka sunucusu); canlıda tanımlanırsa site açılmaz:
# AKBANK_API_URL=
# AKBANK_GATEWAY_URL=

# --- E-posta (Hostinger e-posta hesabı, SMTP) ---
# Boşsa e-postalar kuyrukta bekler (gönderilmez); admin → E-postalar'da uyarı görünür.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Gönderen adresi SMTP_USER ile aynı olmalı
EMAIL_FROM="Çiftçi Ece <siparis@alanadiniz.com>"

# --- Zamanlanmış iş (/api/cron/run; hPanel Cron Jobs 5 dakikada bir çağırır) ---
# En az 24 karakter rastgele: openssl rand -hex 24
CRON_SECRET=

# --- Yalnız ilk kurulumda, bilgisayarınızda (npx prisma db seed); canlıya girmeyin ---
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
