// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Veritabanı: MariaDB (Hostinger web hosting; MySQL uyumlu). Yerel geliştirme ve testler aynı sürüm
// MariaDB ile Docker'da çalışır (docs/TESTING.md).
// MySQL'de String varsayılanı VARCHAR(191): uzun olabilecek metinler @db.Text ya da açık uzunlukla
// tanımlanır (aşan veri katı modda hata verir, katı mod kapalıysa sessizce kesilir).
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// KULLANICI & AUTH
// ============================================================

model User {
  id            String    @id @default(cuid())
  // Müşteri kaydı/girişi e-postayı küçük harfe çevirerek kullanır
  email         String    @unique @db.VarChar(254)
  name          String?
  phone         String?
  passwordHash  String?
  role          Role      @default(CUSTOMER)
  orders        Order[]
  addresses     Address[]
  reviews       ProductReview[]
  passwordResetTokens PasswordResetToken[]
  // "Şifremi unuttum" ile şifre yenilenince: bu andan önce açılmış oturumlar geçersiz sayılır
  passwordResetAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  phone      String
  city       String
  district   String
  postalCode String?
  address    String  @db.Text
  isDefault  Boolean @default(false)

  @@map("addresses")
}

// ============================================================
// ÜRÜNLER & KATEGORİLER
// ============================================================

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  imageUrl    String?   @db.VarChar(500)
  sortOrder   Int       @default(0)
  isPublished Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())

  @@map("categories")
}

model Product {
  id          String           @id @default(cuid())
  name        String           @db.VarChar(255)
  slug        String           @unique
  description String?          @db.Text
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id])
  images      ProductImage[]
  variants    ProductVariant[]
  reviews     ProductReview[]
  isPublished Boolean          @default(false)
  isFeatured  Boolean          @default(false)
  sortOrder   Int              @default(0)
  // KDV oranı, baz puan (100 = %1, 1000 = %10, 2000 = %20). Boş = girilmemiş (bilinmiyor):
  // oran uydurulmaz, sipariş kalemine de boş kopyalanır.
  vatRateBps  Int?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String  @db.VarChar(500)
  altText   String? @db.VarChar(500)
  sortOrder Int     @default(0)

  @@map("product_images")
}

model ProductVariant {
  id          String      @id @default(cuid())
  productId   String
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String      // "500g", "1kg", "5L", "2L"
  sku         String?     @unique
  // Fiyat KURUŞ cinsinden integer — Float KULLANMA
  priceKurus  Int         // 0 = admin panelinden girilmemiş (TODO)
  isAvailable Boolean     @default(true)
  sortOrder   Int         @default(0)
  inventory   Inventory?
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@map("product_variants")
}

model Inventory {
  id        String         @id @default(cuid())
  variantId String         @unique
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(0)
  updatedAt DateTime       @updatedAt

  @@map("inventory")
}

// ============================================================
// SEPET
// ============================================================

model Cart {
  id        String     @id @default(cuid())
  sessionId String?    @unique  // Guest cart
  userId    String?    // Logged-in user cart
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int            @default(1)
  addedAt   DateTime       @default(now())

  @@unique([cartId, variantId])
  @@map("cart_items")
}

// ============================================================
// SİPARİŞ
// ============================================================

model Order {
  id              String      @id @default(cuid())
  // URL'e konan güvenli referans — sequential ID değil
  reference       String      @unique @default(cuid())
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  // Guest checkout bilgileri
  guestEmail      String?     @db.VarChar(254)
  guestName       String?
  guestPhone      String?
  status          OrderStatus @default(PENDING)
  items           OrderItem[]
  payment         Payment?
  // Teslimat adresi JSON snapshot (adres silinse bile bozulmasın)
  shippingAddress Json
  // Fiyatlar KURUŞ cinsinden
  subtotalKurus   Int
  shippingKurus   Int
  discountKurus   Int         @default(0)
  totalKurus      Int
  // Ödeme yöntemi: kart (iyzico), havale/EFT, kapıda ödeme
  paymentMethod   PaymentMethod @default(CARD)
  // Ödeme yöntemine bağlı ek ücret (kapıda ödeme hizmet bedeli); totalKurus'a dahildir
  paymentFeeKurus Int         @default(0)
  // Ödenmezse bu andan sonra otomatik iptal + stok iadesi (kart: 30 dk, havale: ayardaki süre — 48 sa;
  // kapıda ödeme: yok). Süreler lib/payment/reservation.ts
  paymentDueAt    DateTime?
  // Yalnız eski kayıtlar ve insan notu. Kod artık buraya yazmaz: ödeme olayları payment_events'te,
  // uyarılar payment_alerts'ta.
  notes           String?     @db.Text
  // Checkout idempotency: istemcinin ürettiği anahtar (UUID). Aynı anahtarla gelen ikinci istek yeni
  // sipariş açmaz, bu siparişi döndürür. UNIQUE kısıt son savunma hattıdır (eşzamanlı istekler dahil).
  idempotencyKey  String?     @unique
  // İsteğin özeti (SHA-256): aynı anahtar farklı içerikle gelirse sipariş döndürülmez (409)
  idempotencyHash String?
  // NEEDS_ATTENTION: ödeme tarafında insan kararı gereken durum (tutar uyuşmazlığı, çift ödeme, geç ödeme...).
  // Sebep ve ayrıntı payment_alerts'ta. İşaretli sipariş otomatik iptal edilmez.
  needsAttention  Boolean     @default(false)
  paymentAttempts PaymentAttempt[]
  paymentEvents   PaymentEvent[]
  paymentAlerts   PaymentAlert[]
  consents        OrderConsent[]
  emails          EmailMessage[]
  events          OrderEvent[]
  shipments       Shipment[]
  refunds         Refund[]
  requests        CustomerRequest[]
  // Fatura bilgisi (bireysel/kurumsal) — sipariş anındaki hâli: {type, name, companyName, taxOffice,
  // taxNumber, address, sameAsShipping}. Boş = eski sipariş (teslimat bilgileriyle bireysel kabul edilir).
  billingInfo     Json?
  // Müşterinin sipariş notu (teslimat tarifi vb.)
  customerNote    String?     @db.Text
  // Admin'in girdiği fatura numarası ve tarihi (e-Arşiv); müşteri sipariş sayfasında görür
  invoiceNumber   String?     @db.VarChar(60)
  invoiceIssuedAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Süresi dolan siparişleri bulan sorgu (releaseExpiredOrders) tabloyu baştan sona taramasın (R-27)
  @@index([status, paymentDueAt])
  @@map("orders")
}

enum PaymentMethod {
  CARD             // Kredi/banka kartı — ödeme sağlayıcısı (iyzico) üzerinden, taksit seçenekli
  BANK_TRANSFER    // Havale/EFT — satıcı hesabına; admin "ödeme alındı" ile onaylar
  CASH_ON_DELIVERY // Kapıda ödeme — kargo görevlisine teslimatta
}

enum OrderStatus {
  PENDING      // Ödeme bekleniyor
  PAID         // Ödeme alındı
  PROCESSING   // Hazırlanıyor
  SHIPPED      // Kargoya verildi
  DELIVERED    // Teslim edildi
  CANCELLED    // İptal edildi
  REFUNDED     // İade edildi
}

model OrderItem {
  id              String         @id @default(cuid())
  orderId         String
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id])
  // SNAPSHOT — ürün sonradan değişse de sipariş tarihi bilgisi korunur
  snapshotName    String         @db.VarChar(255) // Ürün adı (sipariş anında)
  snapshotVariant String         // Varyant adı (sipariş anında)
  snapshotPrice   Int            // Birim fiyat kuruş (sipariş anında)
  quantity        Int
  // Sipariş anındaki KDV oranı (baz puan); ürün kaydında oran yoksa boş
  vatRateBps      Int?
  // Kalem indirimi (kuruş; birim fiyat × adetten düşülür). Şu an kampanya yok → 0
  discountKurus   Int            @default(0)

  @@map("order_items")
}

// Siparişte müşterinin onayladığı yasal metinler (Ön Bilgilendirme Formu, Mesafeli Satış Sözleşmesi):
// hangi sürüm, ne zaman (sunucu saati), hangi IP'den. Yalnız eklenir.
model OrderConsent {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  // "PRE_INFORMATION_FORM" | "DISTANCE_SALES_CONTRACT" (lib/legal/documents.ts)
  document   String
  version    String
  acceptedAt DateTime
  // İstemci IP'si (vekil sunucu başlığından okunur; başlık güvenilir vekilce yazılmıyorsa doğrulanamaz)
  ipAddress  String?

  @@unique([orderId, document])
  @@map("order_consents")
}

// ============================================================
// ÖDEME
// ============================================================

// ESKİ: sipariş başına tek satırlık ödeme kaydı. Yeni kod bu tabloya yazmaz (yalnız eski siparişlerin
// satırını kapatır); ödemeler payment_attempts'tadır. Eski kayıtlar korunur, tablo silinmez.
model Payment {
  id            String        @id @default(cuid())
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id])
  provider      String        // "iyzico"
  // Provider'ın kendi ödeme token/referansı
  providerRef   String?
  // 3DS conversation ID (iyzico'ya özgü)
  conversationId String?      @unique
  status        PaymentStatus @default(PENDING)
  // Fiyat KURUŞ — provider'dan gelen tutarla karşılaştırılır
  amountKurus   Int
  currency      String        @default("TRY")
  events        PaymentEvent[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("payments")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

// Ödeme denemesi: kartta her iyzico ödeme formu (token) ayrı bir denemedir; havale ve kapıda ödemede
// sipariş başına bir deneme açılır. Satırın üzerine yeni deneme yazılmaz.
// Bir siparişte en fazla BİR başarılı deneme olabilir: successOrderId yalnız SUCCEEDED iken orderId'ye
// eşittir (CHECK kısıtı, migration'da) ve UNIQUE'tir. İkinci doğrulanmış ödeme DUPLICATE olur.
model PaymentAttempt {
  id                 String               @id @default(cuid())
  orderId            String
  // onUpdate: Restrict — MySQL'de CHECK kısıtındaki sütun (orderId) ON UPDATE CASCADE'li yabancı anahtarda
  // kullanılamaz; kimlikler zaten değişmez
  order              Order                @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  provider           String               // "iyzico" | "stub" | "havale" | "kapida"
  method             PaymentMethod
  status             PaymentAttemptStatus @default(INITIATED)
  // Beklenen tutar: deneme açıldığı andaki sipariş toplamı (kuruş)
  amountKurus        Int
  currency           String               @default("TRY")
  // Sağlayıcıya giden conversationId (= bu denemenin id'si)
  conversationId     String?
  // iyzico Ortak Ödeme Formu token'ı ve geçerlilik sonu
  providerToken      String?
  tokenExpiresAt     DateTime?
  providerPaymentId  String?
  // Sağlayıcının bildirdiği sepet tutarı (iyzico price, kuruş)
  paidAmountKurus    Int?
  // Karttan çekilen toplam (iyzico paidPrice: taksit vade farkı dahil olabilir, kuruş)
  chargedAmountKurus Int?
  paidCurrency       String?
  installment        Int?
  fraudStatus        Int?
  failureReason      String?              @db.Text
  successOrderId     String?              @unique
  verifiedAt         DateTime?
  events             PaymentEvent[]
  alerts             PaymentAlert[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([provider, providerToken])
  @@unique([provider, providerPaymentId])
  @@index([orderId])
  @@map("payment_attempts")
}

enum PaymentAttemptStatus {
  INITIATED // Deneme açıldı (kart: ödeme formu verildi; havale/kapıda: ödeme bekleniyor)
  SUCCEEDED // Doğrulanmış ödeme — siparişte en fazla bir tane
  FAILED    // Sağlayıcı ödemenin gerçekleşmediğini bildirdi
  MISMATCH  // Sağlayıcı "başarılı" dedi ama doğrulama tutmadı — para çekilmiş olabilir, insan bakar
  DUPLICATE // Doğrulanmış ödeme ama siparişin başka başarılı ödemesi var — iade gerekir
  EXPIRED   // Sipariş ödenmeden kapandı; sonradan ödeme gelirse yeniden değerlendirilir
}

// Ödeme olayları: sağlayıcı bildirimleri (webhook gelen kutusu), tarayıcı dönüşleri, sunucudan
// sorgular, admin işlemleri ve otomatik işler. Yalnız eklenir; sipariş notunun yerini alır.
// Tekrar koruması: (provider, eventKey) UNIQUE.
model PaymentEvent {
  id              String   @id @default(cuid())
  // ESKİ bağlantı (payments) — yeni kayıtlarda boş
  paymentId       String?
  payment         Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  // ESKİ tekrar alanı — yeni kayıtlar (provider, eventKey) kullanır
  providerEventId String?  @unique
  eventType       String
  // Kart verisi içermez; sağlayıcı yanıtı izinli alanlarla süzülerek yazılır
  payload         Json
  // Kayıt zamanı (eski adıyla). Gelen kutusu olayının işlendiği an: handledAt
  processedAt     DateTime @default(now())
  provider        String?
  eventKey        String?
  source          PaymentEventSource?
  status          PaymentEventStatus @default(RECORDED)
  signatureValid  Boolean?
  orderId         String?
  order           Order?          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  attemptId       String?
  attempt         PaymentAttempt? @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  // İşlemi yapan admin kullanıcısı (elle sorgu, havale onayı)
  actorId         String?
  // İşlemenin sonucu (örn. "paid", "duplicate", "mismatch")
  outcome         String?
  error           String?         @db.Text
  handledAt       DateTime?
  alerts          PaymentAlert[]

  @@unique([provider, eventKey])
  @@index([orderId])
  @@index([attemptId])
  @@index([status])
  @@map("payment_events")
}

enum PaymentEventSource {
  WEBHOOK  // Sağlayıcı bildirimi (gelen kutusu)
  CALLBACK // Müşteri tarayıcısıyla gelen dönüş — kanıt değil, yalnız tetikleyici
  QUERY    // Sağlayıcıya sunucudan otomatik sorgu
  MANUAL   // Admin "iyzico'dan sorgula"
  ADMIN    // Admin işlemi (havale onayı, iptal)
  SYSTEM   // Otomatik iş (süre dolumu)
}

enum PaymentEventStatus {
  RECEIVED  // Gelen kutusunda, işlenmeyi bekliyor
  PROCESSED // İşlendi
  IGNORED   // İşlenecek bir şey yok (bilinmeyen deneme, ara durum)
  FAILED    // İşlenirken hata — yeniden denenebilir
  REJECTED  // İmza doğrulanamadı — işlenmez
  RECORDED  // İç kayıt (bilgi)
}

// Ödeme alarmları: insan kararı gereken durumlar. Siparişi NEEDS_ATTENTION yapar.
// Bildirim kanalı (e-posta/Telegram vb.) ayrı karar (Oturum 6); burada kalıcı kayıt tutulur.
model PaymentAlert {
  id         String          @id @default(cuid())
  // PAYMENT_MISMATCH | DUPLICATE_PAYMENT | LATE_PAYMENT | LATE_PAYMENT_NO_STOCK |
  // PAYMENT_ON_CLOSED_ORDER | FRAUD_REVIEW | WEBHOOK_SIGNATURE_INVALID (lib/payment/alerts.ts)
  kind       String
  orderId    String?
  order      Order?          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  attemptId  String?
  attempt    PaymentAttempt? @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  eventId    String?
  event      PaymentEvent?   @relation(fields: [eventId], references: [id], onDelete: Restrict)
  // Admin'e gösterilen kısa Türkçe açıklama (kişisel veri yok)
  message    String          @db.Text
  details    Json?
  // Aynı durum için ikinci alarm üretilmez
  dedupeKey  String          @unique
  createdAt  DateTime        @default(now())
  resolvedAt DateTime?
  resolvedBy String?

  @@index([orderId])
  @@index([kind, resolvedAt])
  @@map("payment_alerts")
}

// ============================================================
// MÜŞTERİ YORUMLARI
// ============================================================

model Review {
  id           String   @id @default(cuid())
  authorName   String
  authorAvatar String?  @db.VarChar(500) // URL veya initials için null
  rating       Int      // 1-5
  text         String   @db.Text
  date         DateTime
  source       String?  // "google", "manual"
  sourceUrl    String?  @db.VarChar(1000)
  isPublished  Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  @@map("reviews")
}

// ============================================================
// ÜRÜN DEĞERLENDİRMELERİ (üye müşteriler yazar, admin onaylar)
// ============================================================
// Ana sayfadaki "Review" modeli mağaza geneli (Google) yorumlarıdır; bu model ürün sayfasındadır.
// Müşteri başına ürün başına tek değerlendirme: yeniden gönderilirse güncellenir ve tekrar onaya düşer.

model ProductReview {
  id                 String       @id @default(cuid())
  productId          String
  product            Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating             Int          // 1-5
  title              String?
  text               String       @db.Text
  status             ReviewStatus @default(PENDING)
  // Gönderim anında: müşterinin ödenmiş siparişlerinde bu ürün var mı ("Satın aldı" rozeti)
  isVerifiedPurchase Boolean      @default(false)
  // Reddedilme sebebi vb. — yalnız admin görür
  adminNote          String?      @db.Text
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  approvedAt         DateTime?

  @@unique([productId, userId])
  @@index([productId, status])
  @@index([status, createdAt])
  @@map("product_reviews")
}

enum ReviewStatus {
  PENDING   // Onay bekliyor
  APPROVED  // Yayında
  REJECTED  // Reddedildi
}

// ============================================================
// KUPON
// ============================================================

model Coupon {
  id              String     @id @default(cuid())
  code            String     @unique
  type            CouponType
  // Kupon değeri: PERCENTAGE için 0-100, FIXED_AMOUNT için kuruş
  value           Int
  minOrderKurus   Int?       // Minimum sepet tutarı
  usageLimit      Int?       // Toplam kullanım limiti
  usageCount      Int        @default(0)
  isActive        Boolean    @default(true)
  expiresAt       DateTime?
  createdAt       DateTime   @default(now())

  @@map("coupons")
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
}

// ============================================================
// SİTE AYARLARI
// ============================================================

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  // JSON metni (kargo ayarları paket ölçüleriyle birkaç KB olabilir)
  value String @db.Text

  @@map("site_settings")
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

// ============================================================
// ŞİFRE SIFIRLAMA ("Şifremi unuttum")
// ============================================================

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Bağlantıdaki token'ın SHA-256 özeti — token'ın kendisi saklanmaz
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ============================================================
// OUTBOX (dışarıya gidecek olaylar)
// ============================================================
// Ödeme kaydıyla AYNI transaction'da yazılır (ör. tx2: sipariş PAID + "order.paid"). Bu oturumda
// yalnız yazılır; gönderen işçi (bildirim, e-posta, alarm kanalı) Oturum 4/6'da gelecek.
// dedupeKey UNIQUE: aynı olay ikinci kez yazılmaz. Kişisel veri yazılmaz (yalnız kimlik/tutar).
model OutboxEvent {
  id            String    @id @default(cuid())
  // Örn. "order.paid", "payment.alert"
  topic         String
  aggregateType String
  aggregateId   String
  payload       Json
  dedupeKey     String    @unique
  createdAt     DateTime  @default(now())
  // İşçi bu andan sonra işler (yeniden deneme gecikmesi için)
  availableAt   DateTime  @default(now())
  publishedAt   DateTime?
  attempts      Int       @default(0)
  lastError     String?   @db.Text

  @@index([publishedAt, availableAt])
  @@map("outbox_events")
}

// ============================================================
// E-POSTA KUYRUĞU VE KAYDI
// ============================================================
// Her satır gönderilecek (ya da gönderilmiş) bir e-postadır. Sipariş olayları outbox_events'e işlemle
// birlikte yazılır; dağıtıcı (lib/notifications/dispatcher.ts) olayı e-postalara çevirir, gönderici
// (sender.ts) SMTP ile yollar ve sonucu buraya yazar. E-posta sipariş kaydını asla geri almaz: gönderilemezse
// satır kuyrukta kalır, yeniden denenir, admin panelinde görünür.
// dedupeKey UNIQUE: aynı olaydan aynı e-posta ikinci kez oluşmaz. Şifre sıfırlama bağlantısı gibi gizli
// içerik bu tabloya yazılmaz (doğrudan gönderilir).
model EmailMessage {
  id                String      @id @default(cuid())
  // Şablon türü (lib/email/kinds.ts), ör. ORDER_RECEIVED, ORDER_SHIPPED, STORE_NEW_ORDER
  kind              String      @db.VarChar(60)
  dedupeKey         String      @unique @db.VarChar(191)
  orderId           String?
  order             Order?      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  // "customer" | "store"
  audience          String      @db.VarChar(20)
  toAddress         String      @db.VarChar(254)
  replyTo           String?     @db.VarChar(254)
  subject           String      @db.VarChar(300)
  html              String      @db.MediumText
  text              String      @db.MediumText
  status            EmailStatus @default(QUEUED)
  attempts          Int         @default(0)
  // Gönderici bu andan sonra dener (yeniden deneme gecikmesi)
  availableAt       DateTime    @default(now())
  // Gönderim sürerken başka işlem almasın; süre geçerse (süreç çöktü) yeniden denenir
  lockedUntil       DateTime?
  // Bu andan sonra gönderilmez (ör. son ödeme zamanı geçmiş havale hatırlatması)
  expiresAt         DateTime?
  sentAt            DateTime?
  providerMessageId String?     @db.VarChar(300)
  lastError         String?     @db.Text
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([status, availableAt])
  @@index([orderId])
  @@map("email_messages")
}

enum EmailStatus {
  QUEUED    // Gönderilecek
  SENDING   // Gönderiliyor (lockedUntil'e kadar)
  SENT      // SMTP sunucusu kabul etti
  FAILED    // Deneme hakkı bitti ya da kalıcı hata — admin yeniden kuyruğa alabilir
  CANCELLED // Gönderilmeyecek (süresi geçti, admin iptal etti)
}

// ============================================================
// SİPARİŞ GEÇMİŞİ, KARGO, İADE, MÜŞTERİ TALEPLERİ
// ============================================================

// Sipariş geçmişi — yalnız eklenir (R-10, R-20): oluşturma, ödeme, durum değişiklikleri, kargo, iade,
// müşteri talepleri ve admin notları. Kim (actorType/actorId), ne zaman, hangi durumdan hangisine.
// visibleToCustomer: müşterinin sipariş sayfasındaki zaman çizelgesinde görünür (iç notlar görünmez).
model OrderEvent {
  id                String       @id @default(cuid())
  orderId           String
  order             Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  // CREATED | PAYMENT | STATUS | SHIPMENT | REFUND | NOTE | REQUEST | INVOICE
  type              String       @db.VarChar(30)
  fromStatus        OrderStatus?
  toStatus          OrderStatus?
  // SYSTEM | ADMIN | CUSTOMER | PROVIDER
  actorType         String       @db.VarChar(20)
  actorId           String?
  message           String       @db.Text
  visibleToCustomer Boolean      @default(false)
  createdAt         DateTime     @default(now())

  @@index([orderId, createdAt])
  @@map("order_events")
}

// Kargo gönderisi (R-22): "Kargoya verildi" adımında takip numarası zorunlu. Bir siparişte birden fazla
// gönderi olabilir (ek koli, yeniden gönderim).
model Shipment {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  carrier        String   @db.VarChar(60)
  trackingNumber String   @db.VarChar(60)
  // Takip sayfası (firmanın sorgulama bağlantısı); boşsa müşteriye yalnız numara gösterilir
  trackingUrl    String?  @db.VarChar(500)
  shippedAt      DateTime @default(now())
  createdById    String?
  createdAt      DateTime @default(now())

  @@unique([carrier, trackingNumber])
  @@index([orderId])
  @@map("shipments")
}

// İade kaydı (R-07) — yalnız eklenir; ödeme kaydı silinmez/değişmez. Para hareketi sitede otomatik yapılmaz
// (iyzico panelinden ya da havaleyle yapılır), burada kaydı tutulur. Toplam iade, alınan ödemeyi aşamaz
// (kodda, sipariş satırı kilitliyken denetlenir).
model Refund {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  amountKurus Int
  method      RefundMethod
  // iyzico iade işlem no, dekont no vb.
  reference   String?      @db.VarChar(120)
  reason      String       @db.Text
  createdById String?
  createdAt   DateTime     @default(now())

  @@index([orderId])
  @@map("refunds")
}

enum RefundMethod {
  CARD_PROVIDER // iyzico panelinden karta iade
  BANK_TRANSFER // müşterinin hesabına havale
  CASH          // elden
  OTHER
}

// Müşteri talepleri: ödenmiş/hazırlanan siparişte iptal isteği, teslimden sonra cayma (iade) bildirimi.
// Cayma bildirimi yazılı ya da kalıcı veri saklayıcısıyla yapılır (Mesafeli Sözleşmeler Yönetmeliği md. 11):
// talep kaydı + işletmeye e-posta + müşteri sayfasında görünür.
model CustomerRequest {
  id             String                @id @default(cuid())
  orderId        String
  order          Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  type           CustomerRequestType
  message        String                @db.Text
  status         CustomerRequestStatus @default(OPEN)
  resolutionNote String?               @db.Text
  resolvedAt     DateTime?
  resolvedById   String?
  ipAddress      String?               @db.VarChar(64)
  createdAt      DateTime              @default(now())

  @@index([orderId])
  @@index([status, createdAt])
  @@map("customer_requests")
}

enum CustomerRequestType {
  CANCEL // Kargolanmadan iptal isteği
  RETURN // Cayma hakkı / iade
}

enum CustomerRequestStatus {
  OPEN
  RESOLVED
  REJECTED
}

// İletişim formu mesajları — admin → Mesajlar. İşletmeye e-posta bildirimi gider; müşteriye otomatik yanıt
// gönderilmez (formun başkası adına e-posta göndermek için kötüye kullanılmasını önler).
model ContactMessage {
  id             String        @id @default(cuid())
  name           String        @db.VarChar(120)
  email          String        @db.VarChar(254)
  phone          String?       @db.VarChar(30)
  subject        String        @db.VarChar(200)
  message        String        @db.Text
  orderReference String?       @db.VarChar(60)
  status         ContactStatus @default(NEW)
  ipAddress      String?       @db.VarChar(64)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, createdAt])
  @@map("contact_messages")
}

enum ContactStatus {
  NEW      // Okunmadı
  READ     // Okundu
  ANSWERED // Yanıtlandı
  ARCHIVED // Arşivlendi
}
